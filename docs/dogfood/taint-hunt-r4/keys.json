  "exec-js": {
    "language": "javascript",
    "sink_family": "command execution (child_process)",
    "real": {
      "F1": {
        "source": "server.js:8",
        "sinks": [
          "run.js:6"
        ],
        "desc": "query param host -> host.trim() (not a sanitizer) -> exec(`ping -c 1 ${target}`); command injection"
      },
      "F2": {
        "source": "server.js:14",
        "sinks": [
          "run.js:10"
        ],
        "desc": "untrusted X-Filename header -> renamed to name -> execSync(\"tar -cf /tmp/out.tar \" + name); command injection"
      }
    },
    "decoys": {
      "D1": {
        "source": "server.js:20",
        "sinks": [
          "run.js:14"
        ],
        "desc": "execFile(\"ls\", [\"-l\", dir]) uses an argument array and no shell; safe"
      },
      "D2": {
        "source": "server.js:26",
        "sinks": [
          "run.js:18"
        ],
        "desc": "value charset-sanitized to [A-Za-z0-9_-] before exec(`echo ...`); safe"
      },
      "D3": {
        "source": null,
        "sinks": [
          "run.js:22"
        ],
        "desc": "constant execSync(\"node -v\"); no source"
      }
    }
  },
