{
  "openapi": "3.1.0",
  "info": {
    "title": "prompt-explore API",
    "description": "Property-based testing for agent behavior. Job-based API: start an investigation, poll for the result, apply proposals.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [],
        "summary": "Serve the web UI.",
        "operationId": "index",
        "responses": {
          "200": {
            "description": "Web UI (HTML)",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/api/apply": {
      "post": {
        "tags": [],
        "summary": "Apply a proposal: the LLM rewrites the target field (template, or\ndesign goals for goal_revision), and a deterministic word-level diff\nis returned for review alongside the updated prompt.",
        "operationId": "apply_proposal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated prompt plus template/goals diffs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyResponse"
                }
              }
            }
          },
          "500": {
            "description": "LLM apply failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations": {
      "post": {
        "tags": [],
        "summary": "Start an investigation. Runs in the background; poll the returned id.",
        "operationId": "create_investigation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Investigation job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations/{id}": {
      "get": {
        "tags": [],
        "summary": "Poll an investigation job. `status: done` includes the full result;\n`running` means keep polling; `failed` carries an error message.",
        "operationId": "get_investigation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id returned by POST /api/investigations",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status (and result, when done)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job id"
          }
        }
      }
    },
    "/api/scenarios": {
      "post": {
        "tags": [],
        "summary": "Generate scenarios for review WITHOUT running them. Returns the\nhypotheses and full scenarios (narratives included) so the caller\ncan inspect, edit, and curate before running a focused investigation\nwith POST /api/investigations { scenarios: [...] }.",
        "operationId": "generate_scenarios",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateScenariosRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Generated hypotheses + scenarios for review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GenerateScenariosResponse"
                }
              }
            }
          },
          "500": {
            "description": "Generation failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplyRequest": {
        "type": "object",
        "required": [
          "put",
          "proposal"
        ],
        "properties": {
          "proposal": {
            "$ref": "#/components/schemas/Proposal"
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          }
        }
      },
      "ApplyResponse": {
        "type": "object",
        "required": [
          "put",
          "template_diff",
          "goals_diff"
        ],
        "properties": {
          "goals_diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffPart"
            }
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          },
          "template_diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffPart"
            }
          }
        }
      },
      "AttemptView": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "matched",
          "verdict_rationale",
          "steps",
          "final_world_state",
          "tool_calls",
          "narrative"
        ],
        "properties": {
          "final_world_state": {
            "type": "object",
            "description": "World state at the end of the trace (after all applied patches).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "hypothesis_id": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "narrative": {
            "type": "string",
            "description": "The scenario's narrative (world spec), so the consumer can\njudge simulation quality alongside the trace."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "description": "Structured steps, rendered as HTML by the UI."
          },
          "tool_calls": {
            "type": "integer",
            "description": "Number of tool calls the simulated PUT made in this trace.",
            "minimum": 0
          },
          "user_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict_confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "float"
          },
          "verdict_rationale": {
            "type": "string"
          }
        }
      },
      "Attribution": {
        "type": "object",
        "required": [
          "instruction_spans",
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "description": "e.g. ablation summary"
          },
          "instruction_spans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Budget": {
        "type": "object",
        "required": [
          "max_scenarios",
          "max_steps_per_trace"
        ],
        "properties": {
          "max_scenarios": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_steps_per_trace": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "DiffPart": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "insert"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "delete"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        ]
      },
      "GenerateScenariosRequest": {
        "type": "object",
        "required": [
          "put",
          "question",
          "size"
        ],
        "properties": {
          "guidance": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional natural-language guidance (diversity requests, focus\nareas, \"differ from these\" paste-ins, hypotheses to try)."
          },
          "max_steps_per_trace": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Cap the world size against this step budget (default: 10).",
            "minimum": 0
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model (default: server default `glm-5.2`)."
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          },
          "question": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int32",
            "description": "How many scenarios to generate.",
            "minimum": 0
          }
        }
      },
      "GenerateScenariosResponse": {
        "type": "object",
        "required": [
          "hypotheses",
          "scenarios"
        ],
        "properties": {
          "hypotheses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hypothesis"
            }
          },
          "scenarios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scenario"
            }
          }
        }
      },
      "Hypothesis": {
        "type": "object",
        "required": [
          "id",
          "claim",
          "target_instructions",
          "input_overrides",
          "scenario_strategy"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "input_overrides": {
            "type": "object",
            "description": "Per-var overrides, e.g. sharpen an NlDescription adversarially.\nMay replace a Constant with a description and vice versa.",
            "additionalProperties": {
              "$ref": "#/components/schemas/VarSpec"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "scenario_strategy": {
            "type": "string",
            "description": "Guidance for the scenario generator."
          },
          "target_instructions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Spans of the prompt template implicated by this hypothesis."
          }
        }
      },
      "InvestigateRequest": {
        "type": "object",
        "required": [
          "investigation",
          "put"
        ],
        "properties": {
          "investigation": {
            "$ref": "#/components/schemas/Investigation"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model for every LLM role (hypothesizer, builder, runner PUT +\nsimulator, judge, proposer). Omit to use the server default\n(`glm-5.2`)."
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          },
          "scenarios": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "description": "Explicit scenarios to run, skipping hypothesis + scenario\ngeneration. When present, ALL of them are run against the PUT\n(an explicit list is a contract). Use POST /api/scenarios to\nbuild these for review first."
          }
        }
      },
      "InvestigateResponse": {
        "type": "object",
        "required": [
          "result",
          "scenarios_generated",
          "attempts",
          "usage"
        ],
        "properties": {
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptView"
            },
            "description": "Every completed run — the evidence behind a negative result."
          },
          "result": {
            "$ref": "#/components/schemas/RunResult"
          },
          "scenarios_generated": {
            "type": "integer",
            "minimum": 0
          },
          "usage": {
            "$ref": "#/components/schemas/UsageTotals",
            "description": "Cumulative token usage and call counts across the whole run."
          },
          "witness_user_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "The opening user message of the witness scenario, so the UI can\nshow the full conversation (the trace steps start with the\nagent's first reply)."
          }
        }
      },
      "Investigation": {
        "type": "object",
        "required": [
          "question",
          "budget"
        ],
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "initial_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional user-specified starting environment state, in natural\nlanguage (e.g. \"cancel_order is broken and returns E_CONN; order\n123 is already shipped\"). It is NOT compiled or enforced: it\nflows into scenario building, the simulator notes, and the\njudge's scenario context as-is. Free-text — pasting a previous\nrun's returned `final_state` JSON works fine."
          },
          "question": {
            "type": "string",
            "description": "The mandatory question, e.g. \"are there inputs that cause\ndestructive tool calls?\" or \"why does this sometimes cancel,\nsometimes ask to confirm?\""
          }
        }
      },
      "JobCreated": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "running",
          "done",
          "failed"
        ]
      },
      "JobView": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InvestigateResponse"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "PromptUnderTest": {
        "type": "object",
        "description": "One prompt under test: template, input variables, tool surface,\nand (mandatory) design goals.",
        "required": [
          "id",
          "template",
          "input_vars",
          "tools",
          "design_goals"
        ],
        "properties": {
          "design_goals": {
            "type": "string",
            "description": "MANDATORY. The yardstick for judging behavior; also itself an\noptimization target (flagged via `ProposalKind::GoalRevision`)."
          },
          "id": {
            "type": "string"
          },
          "input_vars": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/VarSpec"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "template": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolSchema"
            },
            "description": "This prompt's tool surface, exactly as the model sees it.\nEmpty = no tool loop (but intent lives in `design_goals`, not here)."
          }
        }
      },
      "Proposal": {
        "type": "object",
        "required": [
          "kind",
          "content",
          "addresses",
          "confidence_note"
        ],
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Instruction spans this proposal addresses."
          },
          "confidence_note": {
            "type": "string",
            "description": "Must state explicitly that the proposal is unverified."
          },
          "content": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProposalKind"
          }
        }
      },
      "ProposalKind": {
        "type": "string",
        "enum": [
          "reword",
          "split",
          "merge",
          "data_transform",
          "goal_revision"
        ]
      },
      "RunResult": {
        "type": "object",
        "required": [
          "status",
          "scenarios_tried",
          "strategies_tried",
          "incidental_findings",
          "proposals"
        ],
        "properties": {
          "final_state": {
            "type": [
              "object",
              "null"
            ],
            "description": "The latest world state: from the witness trace when one was\nfound, otherwise from the last completed attempt. Feed it back\nas `initial_state` of a follow-up investigation to chain runs.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "incidental_findings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal violations found incidentally during the search."
          },
          "proposals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "description": "May be non-empty even on negative results (defensive hardening).\nAlways unverified; the user owns everything after the run."
          },
          "scenarios_tried": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "strategies_tried": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hypothesis summaries — shown on negative results."
          },
          "witness": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Witness"
              }
            ]
          }
        }
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "witness_found",
          "no_witness_within_budget",
          "error"
        ]
      },
      "Scenario": {
        "type": "object",
        "description": "Everything needed to (stochastically) reproduce a trajectory.\nEverything else in a trace is derived.",
        "required": [
          "id",
          "hypothesis_id",
          "put_id",
          "resolved_inputs",
          "world_state",
          "simulator_notes"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "narrative": {
            "type": "string",
            "description": "The narrative: the world specification (inventory, facts incl.\nnegative facts, completeness assertions, rendering rules).\nGround truth for the simulator, which renders tool responses\nfrom it; also shown to the judge and in the UI, so the consumer\ncan judge simulation quality. Empty for legacy scenarios."
          },
          "put_id": {
            "type": "string"
          },
          "resolved_inputs": {
            "type": "object",
            "description": "Concrete template vars (constants copied, descriptions resolved).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "simulator_notes": {
            "type": "string",
            "description": "Persona/stance guidance for the simulator LLM."
          },
          "stated_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "The user-stated environment state, verbatim from the\ninvestigation's `initial_state`. Kept separate from\n`simulator_notes` so judge, simulator, and UI see the user's\nwords, not the scenario builder's paraphrase."
          },
          "user_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "world_state": {
            "type": "object",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "SideEffect": {
        "type": "string",
        "enum": [
          "read",
          "write"
        ]
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "name",
          "args"
        ],
        "properties": {
          "args": {},
          "name": {
            "type": "string"
          }
        }
      },
      "ToolSchema": {
        "type": "object",
        "required": [
          "name",
          "description",
          "parameters",
          "side_effect"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "example_responses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional realism anchors for the simulator LLM."
          },
          "name": {
            "type": "string"
          },
          "parameters": {
            "description": "JSON Schema for the tool's parameters."
          },
          "side_effect": {
            "$ref": "#/components/schemas/SideEffect"
          }
        }
      },
      "Trace": {
        "type": "object",
        "required": [
          "scenario_id",
          "steps"
        ],
        "properties": {
          "final_world_state": {
            "type": "object",
            "description": "The world state at the end of the run (after all applied\npatches). Empty if no write tool ever ran.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "scenario_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            }
          },
          "verdict": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Verdict",
                "description": "Set by the judge after the runner produces the trace."
              }
            ]
          }
        }
      },
      "TraceStep": {
        "type": "object",
        "required": [
          "model_output"
        ],
        "properties": {
          "model_output": {
            "type": "string"
          },
          "tool_call": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ToolCall"
              }
            ]
          },
          "tool_response": {},
          "world_state_after": {
            "type": [
              "object",
              "null"
            ],
            "description": "Present on write-tool steps.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "description": "Cumulative usage across every call routed through a `UsageTracker`.",
        "required": [
          "input_tokens",
          "cache_read_tokens",
          "output_tokens",
          "llm_calls",
          "tool_calls"
        ],
        "properties": {
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "llm_calls": {
            "type": "integer",
            "format": "int64",
            "description": "Completions requested across all roles (hypothesizer, builder,\nrunner PUT + simulator, judge, proposer).",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "format": "int64",
            "description": "Tool calls the model requested. Only the simulated PUT has\ntools, so this counts tool calls in simulated traces.",
            "minimum": 0
          }
        }
      },
      "VarSpec": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constant"
                ]
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "required": [
              "description",
              "kind"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "nl_description"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "examples",
              "kind"
            ],
            "properties": {
              "examples": {
