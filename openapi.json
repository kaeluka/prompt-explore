{
  "openapi": "3.1.0",
  "info": {
    "title": "prompt-explore API",
    "description": "Property-based testing for agent behavior. You AUTHOR scenarios (test cases: a world specification plus a protagonist — see the Scenario schema) and submit them with a prompt under test (PUT) and a behavioral question. Every scenario is run: an LLM simulates the world from the scenario's narrative, the PUT acts in it, and a judge evaluates each resulting trace against your question. A witness is a trace where the questioned behavior actually occurred. Proposed prompt fixes are always unverified — apply them (POST /api/apply), then re-run the same scenarios to check. The API is job-based: POST returns a job id immediately; poll GET /api/investigations/{id} for the result.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [],
        "summary": "Serve the web UI.",
        "operationId": "index",
        "responses": {
          "200": {
            "description": "Web UI (HTML)",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/api/apply": {
      "post": {
        "tags": [],
        "summary": "Apply a proposal: the LLM rewrites the target field (template, or\ndesign goals for goal_revision), and a deterministic word-level diff\nis returned for review alongside the updated prompt.",
        "operationId": "apply_proposal",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Updated prompt plus template/goals diffs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplyResponse"
                }
              }
            }
          },
          "500": {
            "description": "LLM apply failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations": {
      "post": {
        "tags": [],
        "summary": "Start an investigation: run every given scenario against the PUT and\njudge each trace against the question. Runs in the background; poll\nthe returned id. The result includes every attempt (scenario + trace\n+ verdict), any witness, unverified fix proposals, and token usage.",
        "operationId": "create_investigation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvestigateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Investigation job created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations/{id}": {
      "get": {
        "tags": [],
        "summary": "Poll an investigation job. `status: done` includes the full result;\n`running` means keep polling; `failed` carries an error message.",
        "operationId": "get_investigation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Job id returned by POST /api/investigations",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job status (and result, when done)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "404": {
            "description": "Unknown job id"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplyRequest": {
        "type": "object",
        "required": [
          "put",
          "proposal"
        ],
        "properties": {
          "proposal": {
            "$ref": "#/components/schemas/Proposal"
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          }
        }
      },
      "ApplyResponse": {
        "type": "object",
        "required": [
          "put",
          "template_diff",
          "goals_diff"
        ],
        "properties": {
          "goals_diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffPart"
            }
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          },
          "template_diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffPart"
            }
          }
        }
      },
      "AttemptView": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "matched",
          "verdict_rationale",
          "steps",
          "final_world_state",
          "tool_calls",
          "narrative"
        ],
        "properties": {
          "final_world_state": {
            "type": "object",
            "description": "World state at the end of the trace (after all applied patches).",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "hypothesis_id": {
            "type": "string"
          },
          "matched": {
            "type": "boolean"
          },
          "narrative": {
            "type": "string",
            "description": "The scenario's narrative (world spec), so the consumer can\njudge simulation quality alongside the trace."
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            },
            "description": "Structured steps, rendered as HTML by the UI."
          },
          "tool_calls": {
            "type": "integer",
            "description": "Number of tool calls the simulated PUT made in this trace.",
            "minimum": 0
          },
          "user_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "verdict_confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "float"
          },
          "verdict_rationale": {
            "type": "string"
          }
        }
      },
      "Attribution": {
        "type": "object",
        "required": [
          "instruction_spans",
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "description": "e.g. ablation summary"
          },
          "instruction_spans": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Budget": {
        "type": "object",
        "required": [
          "max_steps_per_trace"
        ],
        "properties": {
          "max_steps_per_trace": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "max_tokens": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          }
        }
      },
      "DiffPart": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "equal"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "insert"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "value",
              "tag"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "enum": [
                  "delete"
                ]
              },
              "value": {
                "type": "string"
              }
            }
          }
        ]
      },
      "InvestigateRequest": {
        "type": "object",
        "required": [
          "investigation",
          "put",
          "scenarios"
        ],
        "properties": {
          "investigation": {
            "$ref": "#/components/schemas/Investigation"
          },
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Model for every LLM role (runner PUT + simulator, judge,\nproposer). Omit to use the server default (`glm-5.2`)."
          },
          "put": {
            "$ref": "#/components/schemas/PromptUnderTest"
          },
          "scenarios": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scenario"
            },
            "description": "The test cases to run. Required; ALL of them are run (an explicit\nlist is a contract — the step/token budget applies per trace, not\nto the count). Scenarios are authored outside this API and are\neditable before running: reviewing them is the intended workflow."
          }
        }
      },
      "InvestigateResponse": {
        "type": "object",
        "required": [
          "result",
          "scenarios_generated",
          "attempts",
          "usage"
        ],
        "properties": {
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AttemptView"
            },
            "description": "Every completed run — the evidence behind a negative result."
          },
          "result": {
            "$ref": "#/components/schemas/RunResult"
          },
          "scenarios_generated": {
            "type": "integer",
            "minimum": 0
          },
          "usage": {
            "$ref": "#/components/schemas/UsageTotals",
            "description": "Cumulative token usage and call counts across the whole run."
          },
          "witness_user_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "The opening user message of the witness scenario, so the UI can\nshow the full conversation (the trace steps start with the\nagent's first reply)."
          }
        }
      },
      "Investigation": {
        "type": "object",
        "description": "An investigation: run the given scenarios against the PUT and judge\nevery trace against the question.",
        "required": [
          "question",
          "budget"
        ],
        "properties": {
          "budget": {
            "$ref": "#/components/schemas/Budget"
          },
          "initial_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Optional user-specified starting environment state, in natural\nlanguage (e.g. \"cancel_order is broken and returns E_CONN; order\n123 is already shipped\"). It is NOT compiled or enforced: it\nflows into scenario building, the simulator notes, and the\njudge's scenario context as-is. Free-text — pasting a previous\nrun's returned `final_state` JSON works fine."
          },
          "question": {
            "type": "string",
            "description": "The mandatory behavioral question, used VERBATIM as the judge's\ncriterion — e.g. \"are there inputs that cause destructive tool\ncalls?\" or \"why does this sometimes cancel, sometimes ask to\nconfirm?\" A witness is a trace where the judge finds the\nquestioned behavior actually occurred."
          }
        }
      },
      "JobCreated": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "running",
          "done",
          "failed"
        ]
      },
      "JobView": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InvestigateResponse"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          }
        }
      },
      "PromptUnderTest": {
        "type": "object",
        "description": "One prompt under test: the system-prompt template, input variables,\ntool surface, and (mandatory) design goals. The harness executes this\nprompt inside scenario worlds and judges the resulting traces.",
        "required": [
          "id",
          "template",
          "input_vars",
          "tools",
          "design_goals"
        ],
        "properties": {
          "design_goals": {
            "type": "string",
            "description": "MANDATORY. The yardstick for judging behavior: the intent the\nprompt is supposed to uphold. Also itself an optimization target\n(flagged via `ProposalKind::GoalRevision`)."
          },
          "id": {
            "type": "string"
          },
          "input_vars": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/VarSpec"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "template": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToolSchema"
            },
            "description": "This prompt's tool surface, exactly as the model sees it.\nEmpty = no tool loop (but intent lives in `design_goals`, not here)."
          }
        }
      },
      "Proposal": {
        "type": "object",
        "required": [
          "kind",
          "content",
          "addresses",
          "confidence_note"
        ],
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Instruction spans this proposal addresses."
          },
          "confidence_note": {
            "type": "string",
            "description": "Must state explicitly that the proposal is unverified."
          },
          "content": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ProposalKind"
          }
        }
      },
      "ProposalKind": {
        "type": "string",
        "enum": [
          "reword",
          "split",
          "merge",
          "data_transform",
          "goal_revision"
        ]
      },
      "RunResult": {
        "type": "object",
        "required": [
          "status",
          "scenarios_tried",
          "strategies_tried",
          "incidental_findings",
          "proposals"
        ],
        "properties": {
          "final_state": {
            "type": [
              "object",
              "null"
            ],
            "description": "The latest world state: from the witness trace when one was\nfound, otherwise from the last completed attempt. Feed it back\nas `initial_state` of a follow-up investigation to chain runs.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "incidental_findings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Goal violations found incidentally during the search."
          },
          "proposals": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Proposal"
            },
            "description": "May be non-empty even on negative results (defensive hardening).\nAlways unverified; the user owns everything after the run."
          },
          "scenarios_tried": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "strategies_tried": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Hypothesis summaries — shown on negative results."
          },
          "witness": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Witness"
              }
            ]
          }
        }
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "witness_found",
          "no_witness_within_budget",
          "error"
        ]
      },
      "Scenario": {
        "type": "object",
        "description": "A test case: a world specification plus a protagonist. The harness\nruns the prompt under test inside this world — the simulator LLM\nrenders tool responses from the `narrative` — and judges whether the\nquestioned behavior occurred in the resulting trace.\n\nScenarios are authored OUTSIDE the harness (by the operator's agent);\nthis API never generates them. Authoring guidance: the narrative\nshould pin (1) an inventory of what exists, covering every query type\nthe PUT's tools allow, (2) facts, including negative facts (what does\nNOT exist or happen), (3) completeness assertions (\"these are ALL the\nentry points\"), and (4) rendering rules (refuse queries outside the\ninventory; filler introduces no new facts).\n\nEverything needed to (stochastically) reproduce a trajectory lives\nhere; everything else in a trace is derived.",
        "required": [
          "id",
          "hypothesis_id",
          "put_id",
          "resolved_inputs",
          "world_state",
          "simulator_notes"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "description": "Provenance label: what this scenario was authored to test.\nInformational only."
          },
          "id": {
            "type": "string",
            "description": "Free-form label, echoed back in reports."
          },
          "narrative": {
            "type": "string",
            "description": "The world specification — ground truth the simulator renders\ntool responses from, and the judge checks claims against.\nNatural language; see the struct docs for the four parts it\nshould pin."
          },
          "put_id": {
            "type": "string",
            "description": "Provenance: which prompt this scenario was authored for. NOT\nenforced — a scenario may be run against any PUT."
          },
          "resolved_inputs": {
            "type": "object",
            "description": "Concrete values for the PUT template's {{variables}}.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "simulator_notes": {
            "type": "string",
            "description": "Persona/stance guidance for a simulated user, if the scenario\ninvolves one."
          },
          "stated_state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operator-stated environment state, verbatim from the\ninvestigation's `initial_state`. Kept separate from\n`simulator_notes` so judge, simulator, and UI see the operator's\nwords, not a paraphrase."
          },
          "user_message": {
            "type": [
              "string",
              "null"
            ],
            "description": "The opening message from the user/protagonist. For a tool-less\nPUT this is the entire work input."
          },
          "world_state": {
            "type": "object",
            "description": "Mutable world facts, updated by write-tool patches during the\ntrace. Static truth belongs in the narrative, not here.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "SideEffect": {
        "type": "string",
        "enum": [
          "read",
          "write"
        ]
      },
      "ToolCall": {
        "type": "object",
        "required": [
          "name",
          "args"
        ],
        "properties": {
          "args": {},
          "name": {
            "type": "string"
          }
        }
      },
      "ToolSchema": {
        "type": "object",
        "required": [
          "name",
          "description",
          "parameters",
          "side_effect"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "example_responses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional realism anchors for the simulator LLM."
          },
          "name": {
            "type": "string"
          },
          "parameters": {
            "description": "JSON Schema for the tool's parameters."
          },
          "side_effect": {
            "$ref": "#/components/schemas/SideEffect"
          }
        }
      },
      "Trace": {
        "type": "object",
        "required": [
          "scenario_id",
          "steps"
        ],
        "properties": {
          "final_world_state": {
            "type": "object",
            "description": "The world state at the end of the run (after all applied\npatches). Empty if no write tool ever ran.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          },
          "scenario_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TraceStep"
            }
          },
          "verdict": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Verdict",
                "description": "Set by the judge after the runner produces the trace."
              }
            ]
          }
        }
      },
      "TraceStep": {
        "type": "object",
        "required": [
          "model_output"
        ],
        "properties": {
          "model_output": {
            "type": "string"
          },
          "tool_call": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ToolCall"
              }
            ]
          },
          "tool_response": {},
          "world_state_after": {
            "type": [
              "object",
              "null"
            ],
            "description": "Present on write-tool steps.",
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            }
          }
        }
      },
      "UsageTotals": {
        "type": "object",
        "description": "Cumulative usage across every call routed through a `UsageTracker`.",
        "required": [
          "input_tokens",
          "cache_read_tokens",
          "output_tokens",
          "llm_calls",
          "tool_calls"
        ],
        "properties": {
          "cache_read_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "input_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "llm_calls": {
            "type": "integer",
            "format": "int64",
            "description": "Completions requested across all roles (hypothesizer, builder,\nrunner PUT + simulator, judge, proposer).",
            "minimum": 0
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "tool_calls": {
            "type": "integer",
            "format": "int64",
            "description": "Tool calls the model requested. Only the simulated PUT has\ntools, so this counts tool calls in simulated traces.",
            "minimum": 0
          }
        }
      },
      "VarSpec": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "value",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "constant"
                ]
              },
              "value": {}
            }
          },
          {
            "type": "object",
            "required": [
              "description",
              "kind"
            ],
            "properties": {
              "description": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "nl_description"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "examples",
              "kind"
            ],
            "properties": {
              "examples": {
                "type": "array",
                "items": {}
              },
              "kind": {
                "type": "string",
                "enum": [
                  "examples"
                ]
              }
            }
          }
        ],
        "description": "Extensible per-variable data-generation spec.\n\nNew variants must be additive; the serialized form stays\nself-describing via the `kind` tag."
      },
      "Verdict": {
        "type": "object",
        "required": [
          "matched",
          "rationale",
          "matched_step_indices"
        ],
        "properties": {
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "format": "float",
            "description": "The judge's confidence in its own verdict (self-reported)."
          },
          "matched": {
            "type": "boolean",
            "description": "Does this trace satisfy the predicate (∧ design_goals)?"
          },
          "matched_step_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "description": "Where in the trace the match happened."
          },
          "rationale": {
            "type": "string"
          }
        }
      },
      "Witness": {
        "type": "object",
        "required": [
          "traces",
          "attribution"
        ],
        "properties": {
          "attribution": {
            "$ref": "#/components/schemas/Attribution"
          },
          "traces": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trace"
            },
            "description": "1 trace for existential questions, 2 for divergence."
          }
        }
      }
    }
  }
}
